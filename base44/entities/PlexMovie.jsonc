{
  "name": "PlexMovie",
  "type": "object",
  "properties": {
    "rating_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "search_title": {
      "type": "string",
      "description": "Normalized lowercase title used for search and matching"
    },
    "kind": {
      "type": "string",
      "enum": [
        "movie",
        "4k",
        "show"
      ],
      "default": "movie",
      "description": "Plex library type this title came from"
    },
    "year": {
      "type": "number"
    },
    "thumb": {
      "type": "string"
    },
    "library": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "added_at": {
      "type": "number"
    }
  },
  "required": [
    "rating_key",
    "title"
  ]
}