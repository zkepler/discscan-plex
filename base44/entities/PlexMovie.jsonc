{
  "name": "PlexMovie",
  "type": "object",
  "properties": {
    "rating_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "search_title": {
      "type": "string",
      "description": "Normalized lowercase title used for search and matching"
    },
    "kind": {
      "type": "string",
      "enum": [
        "movie",
        "4k",
        "show"
      ],
      "default": "movie",
      "description": "Plex library type this title came from"
    },
    "year": {
      "type": "number"
    },
    "thumb": {
      "type": "string"
    },
    "library": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "added_at": {
      "type": "number",
      "description": "Unix timestamp in seconds for when Plex added the title"
    },
    "progress_pct": {
      "type": "number",
      "description": "How far through the title you are in Plex, 0-100"
    },
    "last_viewed_at": {
      "type": "number",
      "description": "Epoch milliseconds of the last time this was watched in Plex"
    },
    "view_count": {
      "type": "number",
      "description": "How many times Plex has the title marked as played"
    }
  },
  "required": [
    "rating_key",
    "title"
  ]
}