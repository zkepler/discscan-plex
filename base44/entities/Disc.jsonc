{
  "name": "Disc",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the disc"
    },
    "upc": {
      "type": "string",
      "description": "Barcode (UPC/EAN) on the case"
    },
    "format": {
      "type": "string",
      "enum": [
        "DVD",
        "Blu-ray",
        "4K UHD",
        "VHS",
        "LaserDisc",
        "Other"
      ],
      "default": "DVD"
    },
    "year": {
      "type": "number"
    },
    "cover_url": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Where the disc physically lives"
    },
    "notes": {
      "type": "string"
    },
    "plex_rating_key": {
      "type": "string",
      "description": "Matching Plex library item key, when present in Plex"
    },
    "plex_title": {
      "type": "string"
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Directors or creators of the title"
    },
    "studio": {
      "type": "string",
      "description": "Studio, label or distributor"
    },
    "runtime_minutes": {
      "type": "number",
      "description": "Run time in whole minutes"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "string",
      "description": "Content rating, e.g. PG-13 or R"
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lead cast members"
    },
    "plot": {
      "type": "string",
      "description": "Synopsis of the title"
    },
    "edition": {
      "type": "string",
      "description": "Edition or release, e.g. Director's Cut, Steelbook"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}